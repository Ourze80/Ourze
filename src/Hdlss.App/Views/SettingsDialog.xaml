<Window x:Class="Hdlss.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Hdlss.App"
        Style="{StaticResource AppWindow}" Width="720" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Title="{Binding [settings], Source={x:Static app:Loc.Instance}}">
    <StackPanel Margin="22">
        <TextBlock Style="{StaticResource Heading}" Text="{Binding [settings], Source={x:Static app:Loc.Instance}}" Margin="0,0,0,14" />

        <TextBlock Text="{Binding [settings.language], Source={x:Static app:Loc.Instance}}" Margin="0,0,0,6" />
        <ComboBox x:Name="LanguageBox" HorizontalAlignment="Left" Margin="0,0,0,16" />

        <TextBlock Text="{Binding [settings.legacy], Source={x:Static app:Loc.Instance}}" Margin="0,0,0,6" />
        <DockPanel Margin="0,0,0,4">
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="Browse_Click" Content="{Binding [settings.browse], Source={x:Static app:Loc.Instance}}" />
            <TextBox x:Name="LegacyDir" />
        </DockPanel>
        <TextBlock x:Name="LegacyInfo" Style="{StaticResource MutedText}" Margin="0,0,0,16" />

        <TextBlock Text="Librerie Steam aggiuntive (una per riga)" Margin="0,0,0,6" />
        <TextBox x:Name="Libraries" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto" Margin="0,0,0,16" />

        <TextBlock Text="{Binding [settings.data], Source={x:Static app:Loc.Instance}}" Margin="0,0,0,6" />
        <TextBlock x:Name="DataInfo" Style="{StaticResource MutedText}" Margin="0,0,0,8" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Click="Maintenance_Click" Content="{Binding [settings.maintenance], Source={x:Static app:Loc.Instance}}" />
            <Button Click="OpenData_Click" Content="Apri cartella dati" />
        </StackPanel>
        <TextBlock x:Name="MaintenanceInfo" Style="{StaticResource MutedText}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button IsCancel="True" Content="{Binding [plan.cancel], Source={x:Static app:Loc.Instance}}" />
            <Button Style="{StaticResource Primary}" Margin="0" IsDefault="True" Click="Save_Click"
                    Content="{Binding [settings.save], Source={x:Static app:Loc.Instance}}" />
        </StackPanel>
    </StackPanel>
</Window>
