<Window x:Class="Hdlss.App.Views.HistoryDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Hdlss.App"
        Style="{StaticResource AppWindow}" Width="760" Height="520"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Title="{Binding [history.title], Source={x:Static app:Loc.Instance}}">
    <Grid Margin="22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource Heading}" Text="{Binding [history.title], Source={x:Static app:Loc.Instance}}" />
            <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,12"
                       Text="Ogni operazione conserva i file sostituiti. «Annulla» li rimette com'erano, se nel frattempo non sono stati modificati." />
        </StackPanel>
        <ListBox x:Name="List" Grid.Row="1">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold" Text="{Binding Description}" />
                        <TextBlock Style="{StaticResource MutedText}">
                            <Run Text="{Binding Time, StringFormat='{}{0:g}'}" /> · <Run Text="{Binding Status}" /> · <Run Text="{Binding Entries.Count, Mode=OneWay}" /> file
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button IsCancel="True" Content="OK" />
            <Button Style="{StaticResource DangerButton}" Margin="0" Click="Undo_Click"
                    Content="{Binding [history.undo], Source={x:Static app:Loc.Instance}}" />
        </StackPanel>
    </Grid>
</Window>
