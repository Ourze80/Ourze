<Window x:Class="Hdlss.App.Views.GuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Hdlss.App"
        Style="{StaticResource AppWindow}" Width="860" Height="720" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Title="{Binding [guide.window], Source={x:Static app:Loc.Instance}}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <ListBox x:Name="Chapters" Background="{StaticResource Panel}" Padding="8,12" DisplayMemberPath="Title" SelectionChanged="Chapters_SelectionChanged" />
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="28,22" MaxWidth="620" HorizontalAlignment="Left">
                <TextBlock x:Name="ChapterTitle" Style="{StaticResource Title}" FontSize="22" Margin="0,0,0,12" />
                <TextBlock x:Name="ChapterBody" FontSize="14" LineHeight="22" TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
