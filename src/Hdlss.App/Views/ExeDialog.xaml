<Window x:Class="Hdlss.App.Views.ExeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Hdlss.App"
        Style="{StaticResource AppWindow}" Width="760" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize"
        Title="{Binding [exe.title], Source={x:Static app:Loc.Instance}}">
    <StackPanel Margin="22">
        <TextBlock Style="{StaticResource Heading}" Text="{Binding [exe.title], Source={x:Static app:Loc.Instance}}" />
        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,14" TextWrapping="Wrap"
                   Text="{Binding [exe.intro], Source={x:Static app:Loc.Instance}}" />
        <ComboBox x:Name="Targets" MinWidth="0" Margin="0,0,0,8" DisplayMemberPath="Label" SelectionChanged="Targets_SelectionChanged" />
        <Button HorizontalAlignment="Left" Click="Browse_Click" Content="{Binding [exe.browse], Source={x:Static app:Loc.Instance}}" />
        <TextBlock Style="{StaticResource Heading}" Margin="0,22,0,8" Text="{Binding [exe.modFolder], Source={x:Static app:Loc.Instance}}" />
        <CheckBox x:Name="ModAuto" Content="{Binding [exe.modAuto], Source={x:Static app:Loc.Instance}}" Margin="0,0,0,8" Checked="ModAuto_Changed" Unchecked="ModAuto_Changed" />
        <DockPanel>
            <Button x:Name="ModBrowse" DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseMod_Click" Content="{Binding [settings.browse], Source={x:Static app:Loc.Instance}}" />
            <TextBox x:Name="ModFolder" />
        </DockPanel>
        <TextBlock x:Name="ModHint" Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap" />
        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" TextWrapping="Wrap"
                   Text="{Binding [exe.modNote], Source={x:Static app:Loc.Instance}}" />
        <TextBlock Style="{StaticResource Heading}" Margin="0,22,0,8" Text="{Binding [exe.api], Source={x:Static app:Loc.Instance}}" />
        <WrapPanel x:Name="ApiPanel" Margin="0,0,0,6">
            <RadioButton x:Name="ApiAuto" GroupName="api" />
            <RadioButton x:Name="ApiDx11" GroupName="api" Content="DirectX 11" />
            <RadioButton x:Name="ApiDx12" GroupName="api" Content="DirectX 12" />
            <RadioButton x:Name="ApiVulkan" GroupName="api" Content="Vulkan" />
        </WrapPanel>
        <TextBlock Style="{StaticResource MutedText}"
                   Text="{Binding [exe.apiNote], Source={x:Static app:Loc.Instance}}" />
        <TextBlock Style="{StaticResource Heading}" Margin="0,22,0,8" Text="{Binding [exe.unrealTitle], Source={x:Static app:Loc.Instance}}" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Click="BrowseConfig_Click" Content="{Binding [settings.browse], Source={x:Static app:Loc.Instance}}" />
            <TextBox x:Name="ConfigFolder" />
        </DockPanel>
        <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0"
                   Text="{Binding [exe.unrealNote], Source={x:Static app:Loc.Instance}}" />
        <TextBlock x:Name="ErrorText" Foreground="{StaticResource Danger}" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button IsCancel="True" Content="{Binding [plan.cancel], Source={x:Static app:Loc.Instance}}" />
            <Button Style="{StaticResource Primary}" Margin="0" IsDefault="True" Click="Save_Click"
                    Content="{Binding [exe.save], Source={x:Static app:Loc.Instance}}" />
        </StackPanel>
    </StackPanel>
</Window>
