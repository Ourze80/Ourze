<Window x:Class="Hdlss.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:app="clr-namespace:Hdlss.App"
        xmlns:v="clr-namespace:Hdlss.App.Views"
        xmlns:vm="clr-namespace:Hdlss.App.ViewModels"
        Style="{StaticResource AppWindow}"
        Title="{Binding [app.title], Source={x:Static app:Loc.Instance}}"
        Icon="/app.ico" Width="1440" Height="900" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding GoBackCommand}" />
        <KeyBinding Key="Back" Modifiers="Alt" Command="{Binding GoBackCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <v:VisibleWhen x:Key="Vis" />
        <v:ResourceBrush x:Key="Brush" />

        <!-- Path selector card (advanced mode) -->
        <Style x:Key="PathCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="1.5" CornerRadius="10" Padding="14,12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Category tab on the game page: text with an accent underline when selected -->
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="Transparent" BorderBrush="Transparent" BorderThickness="0,0,0,3" Padding="18,10,18,9" Margin="0,0,4,0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ComponentCard" DataType="{x:Type vm:ComponentViewModel}">
            <Border Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="30" Height="30" CornerRadius="15" Background="#262B36" VerticalAlignment="Top" Margin="0,0,14,0"
                            Visibility="{Binding HasStep, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding Step}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding StatusText}" Foreground="{Binding StatusBrush}"
                                       FontSize="13" TextAlignment="Right" MaxWidth="380" Margin="12,2,0,0" />
                            <TextBlock Text="{Binding Name}" Style="{StaticResource Heading}" />
                        </DockPanel>
                        <TextBlock Text="{Binding Description}" Style="{StaticResource MutedText}" Margin="0,4,0,10" />
                        <ItemsControl ItemsSource="{Binding Options}" Visibility="{Binding HasOptions, Converter={StaticResource Vis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource Muted}" />
                                        <ComboBox ItemsSource="{Binding Choices}" SelectedItem="{Binding Selected}" MinWidth="260" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border Background="#2A1D1F" CornerRadius="6" Padding="10,6" Margin="0,0,0,10"
                                Visibility="{Binding HasBlockers, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding BlockersText}" Foreground="#F0A6A0" FontSize="13" />
                        </Border>
                        <Border Background="#33280F" CornerRadius="6" Padding="10,6" Margin="0,0,0,10"
                                Visibility="{Binding IsUnavailable, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding UnavailableText}" Foreground="{StaticResource Accent}" FontSize="13" TextWrapping="Wrap" />
                        </Border>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource Primary}" Content="Importa in HDLSS5" Command="{Binding ImportExternalCommand}"
                                    ToolTip="Prende in gestione i file installati dall'altro programma, senza modificare il gioco."
                                    Visibility="{Binding CanImportExternal, Converter={StaticResource Vis}}" />
                            <Button Style="{StaticResource Primary}" Content="{Binding ActionLabel}" Command="{Binding InstallCommand}"
                                    Visibility="{Binding ShowAction, Converter={StaticResource Vis}}" />
                            <TextBlock Text="{Binding CheckingText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Visibility="{Binding IsChecking, Converter={StaticResource Vis}}" />
                            <Button Content="Reinstalla" Command="{Binding InstallCommand}"
                                    ToolTip="Non riesco a sapere se c'è una versione più recente (offline o fonte senza versioni): reinstalla l'ultima disponibile."
                                    Visibility="{Binding ShowReinstall, Converter={StaticResource Vis}}" />
                            <Button Content="{Binding ImportLabel}" Command="{Binding ImportCommand}"
                                    Visibility="{Binding CanImportFile, Converter={StaticResource Vis}}" />
                            <Button Style="{StaticResource DangerButton}" Command="{Binding RemoveCommand}"
                                    Content="{Binding [component.remove], Source={x:Static app:Loc.Instance}}"
                                    Visibility="{Binding IsManaged, Converter={StaticResource Vis}}" />
                            <Button Style="{StaticResource Ghost}" Command="{Binding RemoveForceCommand}"
                                    Content="{Binding [component.removeForce], Source={x:Static app:Loc.Instance}}"
                                    ToolTip="Rimuove i file di HDLSS5 lasciando invariati quelli modificati da altro software."
                                    Visibility="{Binding IsManaged, Converter={StaticResource Vis}}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="84" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ═════════════ Navigation rail ═════════════ -->
        <DockPanel Grid.RowSpan="3" Background="{StaticResource Panel}">
            <Image DockPanel.Dock="Top" Source="/logo.png" Width="40" Height="40" Margin="12,16,12,20" RenderOptions.BitmapScalingMode="HighQuality"
                   ToolTip="{Binding GpuText}" />
            <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,12">
                <ToggleButton IsChecked="{Binding Advanced}" Cursor="Hand" Margin="6,2" Background="Transparent" BorderThickness="0"
                              ToolTip="Modalità avanzata: percorsi, opzioni di ogni componente, installazioni 1.x e cronologia.">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="b" Background="Transparent" CornerRadius="8" Padding="0,8">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock x:Name="icon" Text="&#xE90F;" FontFamily="{StaticResource IconFont}" FontSize="18" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" />
                                    <TextBlock x:Name="label" Text="Avanzate" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" Foreground="{StaticResource Muted}" />
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="icon" Property="Foreground" Value="{StaticResource Accent}" />
                                    <Setter TargetName="label" Property="Foreground" Value="{StaticResource Accent}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <Button Style="{StaticResource RailAction}" Command="{Binding OpenGuideCommand}" ToolTip="Guida passo per passo">
                    <StackPanel>
                        <TextBlock Text="&#xE897;" FontFamily="{StaticResource IconFont}" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="Guida" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource RailAction}" Command="{Binding OpenSettingsCommand}" ToolTip="Impostazioni">
                    <StackPanel>
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="18" HorizontalAlignment="Center" />
                        <TextBlock Text="Impostazioni" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <RadioButton Style="{StaticResource RailButton}" GroupName="nav" IsChecked="{Binding IsGamesSection, Mode=OneWay}" Command="{Binding ShowLibraryCommand}">
                    <StackPanel>
                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="20" HorizontalAlignment="Center" />
                        <TextBlock Text="Giochi" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource RailButton}" GroupName="nav" IsChecked="{Binding IsDlss, Mode=OneWay}" Command="{Binding ShowDlssCommand}"
                             ToolTip="DLL NVIDIA dei tuoi giochi (DLSS e Streamline): versioni e aggiornamenti">
                    <StackPanel>
                        <TextBlock Text="&#xE9F5;" FontFamily="{StaticResource IconFont}" FontSize="20" HorizontalAlignment="Center" />
                        <TextBlock Text="DLL" FontSize="11" Margin="0,4,0,0" HorizontalAlignment="Center" />
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </DockPanel>

        <!-- ═════════════ Library ═════════════ -->
        <DockPanel Grid.Column="1" Visibility="{Binding IsLibrary, Converter={StaticResource Vis}}">
            <StackPanel DockPanel.Dock="Top" Margin="40,28,40,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="280" Margin="0,0,10,0">
                            <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="32,7,8,7" />
                            <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Muted}" Margin="11,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False" />
                            <TextBlock Text="Cerca  (Ctrl+F)" Foreground="{StaticResource Muted}" Margin="33,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource Vis}, ConverterParameter=invert}" />
                        </Grid>
                        <Button Command="{Binding AddGameCommand}" Content="+ Aggiungi gioco" ToolTip="Aggiungi un gioco non trovato automaticamente scegliendo il suo .exe" />
                        <Button Command="{Binding RefreshCommand}" Margin="0" ToolTip="Cerca di nuovo i giochi installati (F5)">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" />
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="I tuoi giochi" Style="{StaticResource Title}" />
                        <TextBlock Text="{Binding LibrarySummary}" Style="{StaticResource MutedText}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
                <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                    <RadioButton Style="{StaticResource ChipToggle}" GroupName="filter" IsChecked="{Binding FilterAll}" Content="Tutti" />
                    <RadioButton Style="{StaticResource ChipToggle}" GroupName="filter" IsChecked="{Binding FilterActive}" Content="Con Neural Rendering" />
                    <RadioButton Style="{StaticResource ChipToggle}" GroupName="filter" IsChecked="{Binding FilterAttention}" Content="Da sistemare" />
                </StackPanel>
            </StackPanel>
            <Grid>
                <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Margin="40,0" Visibility="{Binding Scanning, Converter={StaticResource Vis}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,8,18,24">
                    <ItemsControl ItemsSource="{Binding GamesView}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:GameItemViewModel}">
                                <Button Style="{StaticResource GameCard}" Command="{Binding DataContext.OpenGameCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}" ToolTip="{Binding Name}">
                                    <StackPanel>
                                        <Grid Height="240" Background="#232835">
                                            <TextBlock Text="{Binding Initial}" FontSize="48" FontWeight="Bold" Foreground="#3A4152"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" CornerRadius="4" Background="#CC0F1115" Padding="6,2">
                                                <TextBlock Text="{Binding StoreLabel}" FontSize="10" Foreground="{StaticResource Muted}" />
                                            </Border>
                                        </Grid>
                                        <Border Background="{StaticResource Card}" Padding="10,8,10,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                    <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{Binding StatusBrush}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="135" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>

        <!-- ═════════════ Game page ═════════════ -->
        <ScrollViewer Grid.Column="1" DataContext="{Binding Detail}" VerticalScrollBarVisibility="Auto"
                      Visibility="{Binding DataContext.IsGame, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
            <StackPanel>
                <Grid Height="320" ClipToBounds="True">
                    <Image Source="{Binding Hero}" Stretch="UniformToFill" VerticalAlignment="Top" Opacity="0.55" />
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#330F1115" Offset="0" />
                                <GradientStop Color="#FF0F1115" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Button HorizontalAlignment="Left" VerticalAlignment="Top" Margin="28,22,0,0" Background="#AA0F1115"
                            Command="{Binding DataContext.GoBackCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Torna ai giochi (Esc)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="Giochi" />
                        </StackPanel>
                    </Button>
                    <StackPanel VerticalAlignment="Bottom" Margin="40,0,40,8">
                        <TextBlock Text="{Binding Name}" FontSize="34" FontWeight="Bold" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Chips}" Margin="0,10,0,0">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Chip}" Background="#CC1E222B"><TextBlock Text="{Binding}" FontSize="12" /></Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>

                <StackPanel Margin="40,8,40,40" MaxWidth="1100" HorizontalAlignment="Left">
                    <ProgressBar IsIndeterminate="True" Visibility="{Binding Loading, Converter={StaticResource Vis}}" Margin="0,0,0,12" />

                    <!-- DLSS 5 card: the main job of the app. Method choice first, then status and the one next step. -->
                    <Border Style="{StaticResource CardBorder}" Padding="26,22">
                        <StackPanel>
                            <TextBlock Text="DLSS 5 · Neural Rendering" Style="{StaticResource MutedText}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,10" />
                            <TextBlock Text="Come vuoi installarlo?" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8"
                                       Visibility="{Binding MethodsEnabled, Converter={StaticResource Vis}}" />
                            <UniformGrid Columns="2" Margin="0,0,-10,18" Visibility="{Binding MethodsEnabled, Converter={StaticResource Vis}}">
                                <RadioButton Style="{StaticResource PathCard}" GroupName="method" IsChecked="{Binding IsMethodReShade}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="#33280F" CornerRadius="8" Padding="8,2"
                                                    Visibility="{Binding ReShadeRecommended, Converter={StaticResource Vis}}">
                                                <TextBlock Text="Consigliato" FontSize="11" Foreground="{StaticResource Accent}" />
                                            </Border>
                                            <TextBlock Text="Tramite ReShade" FontSize="16" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding ReShadeDescription}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource PathCard}" GroupName="method" IsChecked="{Binding IsMethodOpti}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Background="#33280F" CornerRadius="8" Padding="8,2"
                                                    Visibility="{Binding OptiRecommended, Converter={StaticResource Vis}}">
                                                <TextBlock Text="Consigliato" FontSize="11" Foreground="{StaticResource Accent}" />
                                            </Border>
                                            <TextBlock Text="Tramite OptiScaler" FontSize="16" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding OptiDescription}" Style="{StaticResource MutedText}" Margin="0,6,0,0" />
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                            <TextBlock Text="{Binding Headline}" FontSize="22" FontWeight="SemiBold" Foreground="{Binding HeadlineBrushKey, Converter={StaticResource Brush}}" />
                            <TextBlock Text="{Binding Explanation}" FontSize="15" Margin="0,8,0,0" Foreground="#C9CEDA" LineHeight="22" />
                            <StackPanel Margin="0,14,0,0" Visibility="{Binding HasPlanSteps, Converter={StaticResource Vis}}">
                                <TextBlock Text="Cosa verrà fatto" Style="{StaticResource MutedText}" Margin="0,0,0,6" />
                                <ItemsControl ItemsSource="{Binding PlanSteps}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="0,2">
                                                <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource Accent}" Margin="0,2,8,0" />
                                                <TextBlock Text="{Binding}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <WrapPanel Margin="0,20,0,0">
                                <Button Style="{StaticResource BigPrimary}" Content="{Binding PrimaryLabel}" Command="{Binding RunPrimaryCommand}"
                                        Visibility="{Binding HasPrimary, Converter={StaticResource Vis}}" />
                                <Button Style="{StaticResource Big}" Command="{Binding LaunchCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE768;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBlock Text="Gioca" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource Big}" Content="Disattiva" Command="{Binding DisableCommand}"
                                        Visibility="{Binding CanDisable, Converter={StaticResource Vis}}"
                                        ToolTip="Toglie il Neural Rendering e rimette i file originali. ReShade e le altre mod restano." />
                                <Button Style="{StaticResource Ghost}" Content="Apri cartella" Command="{Binding OpenFolderCommand}" VerticalAlignment="Center" />
                            </WrapPanel>

                            <!-- "Did it work?" answer -->
                            <Border Margin="0,18,0,0" CornerRadius="8" Padding="16,12" Background="#161A21"
                                    BorderThickness="1" BorderBrush="{Binding VerifyBrushKey, Converter={StaticResource Brush}}"
                                    Visibility="{Binding HasVerify, Converter={StaticResource Vis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding VerifyTitle}" FontWeight="SemiBold" FontSize="15" Foreground="{Binding VerifyBrushKey, Converter={StaticResource Brush}}" />
                                    <TextBlock Text="{Binding VerifyDetails}" Margin="0,6,0,0" Foreground="#C9CEDA" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border CornerRadius="8" Padding="16,12" Margin="0,0,0,12" Background="#2A1E14" BorderBrush="{StaticResource Warn}" BorderThickness="1"
                            Visibility="{Binding HasBanner, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="{Binding BannerLabel}" Command="{Binding RunBannerCommand}" Margin="12,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding BannerText}" VerticalAlignment="Center" Foreground="#F2D6BE" />
                        </DockPanel>
                    </Border>                    <Border Background="#2A1D1F" CornerRadius="8" Padding="14,10" Margin="0,0,0,12" Visibility="{Binding Error, Converter={StaticResource Vis}}">
                        <TextBlock Text="{Binding Error}" Foreground="#F0A6A0" />
                    </Border>
                    <ItemsControl ItemsSource="{Binding Warnings}" Margin="0,0,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Foreground="{StaticResource Warn}" Margin="0,0,0,4"><Run Text="⚠ " /><Run Text="{Binding Mode=OneWay}" /></TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- ReShade ↔ OptiScaler compatibility -->
                    <Border CornerRadius="8" Padding="16,12" Margin="0,0,0,12" Background="#2A1D1F" BorderBrush="{StaticResource Danger}" BorderThickness="1"
                            Visibility="{Binding HasCompat, Converter={StaticResource Vis}}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Risolvi" Command="{Binding FixCompatCommand}" Margin="12,0,0,0" VerticalAlignment="Center"
                                    ToolTip="Sposta ReShade sul caricatore giusto (ReShade64.dll caricato da OptiScaler, o dxgi.dll). Annullabile dalla cronologia."
                                    Visibility="{Binding CanFixCompat, Converter={StaticResource Vis}}" />
                            <StackPanel>
                                <TextBlock Text="Conflitto tra ReShade e OptiScaler" FontWeight="SemiBold" Foreground="#F0A6A0" Margin="0,0,0,4" />
                                <ItemsControl ItemsSource="{Binding CompatIssues}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Text}" Foreground="#E8C9C6" TextWrapping="Wrap" Margin="0,2" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- Category tabs: ReShade / OptiScaler / DLL / Altro -->
                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Margin="0,14,0,14">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" IsChecked="{Binding ShowAll}" Content="Mostra anche i non adatti" VerticalAlignment="Center"
                                      ToolTip="Mostra anche i componenti che HDLSS5 ritiene non adatti a questo gioco." />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton Style="{StaticResource TabButton}" GroupName="gametab" IsChecked="{Binding IsTabReShade}" Content="{Binding TabReShadeLabel}" />
                                <RadioButton Style="{StaticResource TabButton}" GroupName="gametab" IsChecked="{Binding IsTabOpti}" Content="{Binding TabOptiLabel}" />
                                <RadioButton Style="{StaticResource TabButton}" GroupName="gametab" IsChecked="{Binding IsTabDll}" Content="{Binding TabDllLabel}" />
                                <RadioButton Style="{StaticResource TabButton}" GroupName="gametab" IsChecked="{Binding IsTabOther}" Content="{Binding TabOtherLabel}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock Text="{Binding TabDescription}" Style="{StaticResource MutedText}" Margin="0,0,0,12" />
                    <ItemsControl ItemsSource="{Binding TabComponents}" ItemTemplate="{StaticResource ComponentCard}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" Visibility="{Binding TabEmpty, Converter={StaticResource Vis}}"
                               Text="Nessun componente adatto a questo gioco in questa categoria. Spunta «Mostra anche i non adatti» per vederli tutti." />

                    <!-- Advanced (for tinkerers) -->
                    <Border Margin="0,18,0,0" Padding="14,10" CornerRadius="8" Background="#161A21"
                            Visibility="{Binding Advanced, Converter={StaticResource Vis}, ConverterParameter=invert}">
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Content="Mostra"
                                      IsChecked="{Binding DataContext.Advanced, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <TextBlock Style="{StaticResource MutedText}" VerticalAlignment="Center"
                                       Text="Opzioni avanzate: eseguibile e API, installazioni 1.x e di altri programmi, cronologia e anteprima di ogni modifica." />
                        </DockPanel>
                    </Border>
                    <StackPanel Visibility="{Binding Advanced, Converter={StaticResource Vis}}" Margin="0,22,0,0">
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Content="Eseguibile e API…" Command="{Binding EditExeCommand}" />
                                <Button Content="Cronologia" Command="{Binding HistoryCommand}" Margin="0" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Heading}" Text="Avanzate" />
                                <TextBlock Text="{Binding ExeText}" Style="{StaticResource MutedText}" FontFamily="{StaticResource MonoFont}" FontSize="12" />
                            </StackPanel>
                        </DockPanel>

                        <Border Style="{StaticResource CardBorder}" BorderBrush="{StaticResource Warn}" Visibility="{Binding HasLegacy, Converter={StaticResource Vis}}">
                            <Expander IsExpanded="False">
                                <Expander.Header>
                                    <TextBlock Style="{StaticResource Heading}">
                                        <Run Text="{Binding [legacy.title], Source={x:Static app:Loc.Instance}, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding Legacy.Count, Mode=OneWay}" />
                                    </TextBlock>
                                </Expander.Header>
                                <StackPanel Margin="0,8,0,0">
                                    <TextBlock Style="{StaticResource MutedText}" Margin="0,0,0,10" Text="{Binding [legacy.desc], Source={x:Static app:Loc.Instance}}" />
                                    <ItemsControl ItemsSource="{Binding Legacy}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:LegacyItemViewModel}">
                                                <DockPanel Margin="0,0,0,8">
                                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                        <Button Style="{StaticResource Primary}" Command="{Binding AdoptCommand}" Content="Adotta"
                                                                Visibility="{Binding CanAdopt, Converter={StaticResource Vis}}" />
                                                        <Button Command="{Binding RestoreCommand}" Content="{Binding [legacy.restore], Source={x:Static app:Loc.Instance}}" />
                                                        <Button Style="{StaticResource Ghost}" Command="{Binding RestoreForceCommand}" Content="Ripristina comunque" Margin="0" />
                                                    </StackPanel>
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}" />
                                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>
                        </Border>

                        <Border Style="{StaticResource CardBorder}" BorderBrush="{StaticResource Warn}" Visibility="{Binding HasForeign, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Heading}" Text="Installati da altri programmi" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,10"
                                           Text="«Importa» li fa gestire a HDLSS5 senza modificare il gioco. Se l'altro programma ha lasciato una copia dell'originale, «Rimuovi» rimetterà quella." />
                                <ItemsControl ItemsSource="{Binding Foreign}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ForeignItemViewModel}">
                                            <DockPanel Margin="0,0,0,8">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Primary}" Content="Importa" Command="{Binding ImportCommand}" Margin="0" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}" />
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource CardBorder}" Visibility="{Binding HasUnknown, Converter={StaticResource Vis}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Heading}" Text="Altri iniettori non gestibili" />
                                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,10"
                                           Text="File iniettati da programmi che HDLSS5 non conosce. Non vengono toccati, ma possono entrare in conflitto con il Neural Rendering: se qualcosa non funziona, toglili con il programma che li ha installati." />
                                <ItemsControl ItemsSource="{Binding UnknownInjectors}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Margin="0,0,0,4"><Run Text="{Binding Path, Mode=OneWay}" FontFamily="{StaticResource MonoFont}" /><Run Text="  ·  " Foreground="{StaticResource Muted}" /><Run Text="{Binding Description, Mode=OneWay}" Foreground="{StaticResource Muted}" /></TextBlock>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ═════════════ DLL page (DLSS + Streamline) ═════════════ -->
        <DockPanel Grid.Column="1" DataContext="{Binding DlssPage}"
                   Visibility="{Binding DataContext.IsDlss, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Vis}}">
            <Grid DockPanel.Dock="Top" Margin="40,28,40,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MaxWidth="1100" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="DLL dei tuoi giochi" Style="{StaticResource Title}" />
                <TextBlock Style="{StaticResource MutedText}" Margin="0,4,0,0" MaxWidth="820" HorizontalAlignment="Left"
                           Text="Molti giochi includono versioni vecchie delle DLL NVIDIA: DLSS (Super Resolution, Frame Generation, Ray Reconstruction) e Streamline. Aggiornarle spesso migliora qualità e stabilità. Gli originali restano salvati: scegli «Originale del gioco» nel menu per rimetterli. Nei giochi online con anti-cheat è meglio non aggiornare." />
                <DockPanel Margin="0,16,0,0">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource Primary}" Command="{Binding UpdateAllCommand}"
                                Visibility="{Binding HasOutdated, Converter={StaticResource Vis}}">
                            <TextBlock><Run Text="Porta tutti alle più recenti (" /><Run Text="{Binding OutdatedCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                        </Button>
                        <Button Command="{Binding RefreshCommand}" Margin="0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72C;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBlock Text="Controlla di nuovo" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <WrapPanel VerticalAlignment="Center">
                        <Border Style="{StaticResource Chip}"><TextBlock Text="{Binding Summary}" FontSize="13" FontWeight="SemiBold" /></Border>
                        <Border Style="{StaticResource Chip}" Visibility="{Binding HasNewest, Converter={StaticResource Vis}}">
                            <TextBlock Text="{Binding Newest}" FontSize="13" Foreground="{StaticResource Muted}" />
                        </Border>
                    </WrapPanel>
                </DockPanel>
            </StackPanel>
            </Grid>
            <Grid>
                <ProgressBar IsIndeterminate="True" VerticalAlignment="Top" Margin="40,0" Visibility="{Binding Checking, Converter={StaticResource Vis}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,8,40,40">
                    <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="1100" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ItemsControl ItemsSource="{Binding Games}" Grid.IsSharedSizeScope="True">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DlssGameViewModel}">
                                <Border Style="{StaticResource CardBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="76" Height="108" CornerRadius="6" ClipToBounds="True" Background="#232835" Margin="0,0,20,0" VerticalAlignment="Top">
                                            <Image Source="{Binding Cover}" Stretch="UniformToFill" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <!-- Same header as the component cards: name left, state right -->
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding StateText}" Foreground="{Binding StateBrush}" FontSize="13" Margin="12,2,0,0" />
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Heading}" />
                                            </DockPanel>
                                            <!-- What the game has now, one line per DLL -->
                                            <ItemsControl ItemsSource="{Binding Rows}" ToolTip="{Binding FilesTooltip}" Background="Transparent" Margin="0,10,0,12">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="DllKind" />
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="DllCurrent" />
                                                                <ColumnDefinition Width="Auto" SharedSizeGroup="DllState" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Text="{Binding Kind}" FontSize="14" Foreground="{StaticResource Text}" Margin="0,0,24,0" />
                                                            <TextBlock Grid.Column="1" Text="{Binding Current}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Accent}" Margin="0,0,16,0" />
                                                            <TextBlock Grid.Column="2" Text="{Binding StateText}" FontSize="14" Margin="0,0,16,0">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Foreground" Value="{StaticResource Success}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsOutdated}" Value="True">
                                                                                <Setter Property="Foreground" Value="{StaticResource Warn}" />
                                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>
                                                            <TextBlock Grid.Column="3" Text="{Binding FoldersText}" FontSize="13" Foreground="{StaticResource Muted}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <!-- Choices, laid out like component options -->
                                            <WrapPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,24,10" Visibility="{Binding HasDlss, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="DLSS" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource Muted}" />
                                                    <ComboBox ItemsSource="{Binding DlssChoices}" SelectedItem="{Binding SelectedDlss}" MinWidth="280"
                                                              ToolTip="Più recente, una versione precedente oppure le DLL originali del gioco" />
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,24,10" Visibility="{Binding HasStreamline, Converter={StaticResource Vis}}">
                                                    <TextBlock Text="Streamline" VerticalAlignment="Center" Margin="0,0,10,0" Foreground="{StaticResource Muted}" />
                                                    <ComboBox ItemsSource="{Binding StreamlineChoices}" SelectedItem="{Binding SelectedStreamline}" MinWidth="280"
                                                              ToolTip="Più recente, una versione precedente oppure le DLL originali del gioco" />
                                                </StackPanel>
                                            </WrapPanel>
                                            <Button Style="{StaticResource Primary}" Content="Applica" Command="{Binding ApplyCommand}" HorizontalAlignment="Left"
                                                    Visibility="{Binding HasChanges, Converter={StaticResource Vis}}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </DockPanel>

        <!-- ═════════════ Status bar + log drawer ═════════════ -->
        <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <StackPanel>
                <ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding ProgressIndeterminate}" Maximum="100"
                             Visibility="{Binding Busy, Converter={StaticResource Vis}}" />
                <DockPanel Margin="16,6">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Command="{Binding ToggleLogCommand}" Margin="8,0,0,0" Padding="8,2">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding [log], Source={x:Static app:Loc.Instance}}" />
                            <TextBlock Text="&#xE70E;" FontFamily="{StaticResource IconFont}" Margin="6,2,0,0" FontSize="10" />
                        </StackPanel>
                    </Button>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Ghost}" Content="Annulla" Command="{Binding CancelCommand}" Margin="0" Padding="8,2"
                            Visibility="{Binding Busy, Converter={StaticResource Vis}}" />
                    <TextBlock DockPanel.Dock="Right" Text="{Binding GpuText}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="12,0" />
                    <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                </DockPanel>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Grid.Column="1" Background="#0B0D10" Height="190" Visibility="{Binding LogOpen, Converter={StaticResource Vis}}">
            <ListBox x:Name="LogList" ItemsSource="{Binding LogLines}" FontFamily="{StaticResource MonoFont}" FontSize="12" Margin="8,4" />
        </Border>
    </Grid>
</Window>
